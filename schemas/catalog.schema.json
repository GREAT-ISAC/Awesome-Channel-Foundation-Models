{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GREAT-ISAC/Awesome-Channel-Foundation-Models/schemas/catalog.schema.json",
  "title": "Awesome Channel Foundation Models catalog record",
  "oneOf": [
    { "$ref": "#/$defs/paper" },
    { "$ref": "#/$defs/dataset" },
    { "$ref": "#/$defs/model" },
    { "$ref": "#/$defs/simulationTool" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "slugList": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "scope": {
      "enum": [
        "cfm-ecosystem",
        "related-method"
      ]
    },
    "pretrainingObjective": {
      "enum": [
        "masked-reconstruction",
        "predictive-generative",
        "contrastive-alignment",
        "predictive-latent",
        "direct-optimization",
        "task-supervised"
      ]
    },
    "provenance": {
      "enum": ["official", "community"]
    },
    "availability": {
      "enum": [
        "available",
        "restricted",
        "not-released",
        "not-found",
        "broken"
      ]
    },
    "externalLink": {
      "type": "object",
      "required": ["label", "url", "provenance", "availability"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/httpUrl" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "availability": {
          "enum": ["available", "restricted", "broken"]
        },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "directArtifactItem": {
      "type": "object",
      "required": ["label", "url", "provenance", "availability"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/httpUrl" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "availability": {
          "enum": ["available", "restricted", "broken"]
        },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "artifactReference": {
      "type": "object",
      "required": ["label", "ref"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "ref": { "$ref": "#/$defs/id" }
      }
    },
    "artifactItem": {
      "oneOf": [
        { "$ref": "#/$defs/directArtifactItem" },
        { "$ref": "#/$defs/artifactReference" }
      ]
    },
    "artifactSlot": {
      "type": "object",
      "required": ["status", "items"],
      "additionalProperties": false,
      "properties": {
        "status": { "$ref": "#/$defs/availability" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactItem" }
        }
      }
    },
    "paper": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "short_name",
        "title",
        "authors",
        "year",
        "venue",
        "paper_url",
        "scope",
        "stages",
        "training_signals",
        "objectives",
        "primary_objective",
        "task_regime",
        "modalities",
        "tasks",
        "artifacts",
        "last_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "paper" },
        "id": { "$ref": "#/$defs/id" },
        "short_name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
        "venue": { "type": "string", "minLength": 1 },
        "paper_url": { "type": "string", "minLength": 1 },
        "local_url": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "survey",
              "backbone",
              "pretraining",
              "application",
              "adaptation",
              "inference-deployment"
            ]
          }
        },
        "objectives": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pretrainingObjective" }
        },
        "primary_objective": {
          "oneOf": [
            { "$ref": "#/$defs/pretrainingObjective" },
            { "type": "null" }
          ]
        },
        "training_signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["self-supervised", "supervised", "weakly-supervised"]
          }
        },
        "task_regime": {
          "enum": [
            "single-task",
            "multitask",
            "task-conditioned",
            "not-specified",
            "not-applicable"
          ]
        },
        "modalities": { "$ref": "#/$defs/slugList" },
        "tasks": { "$ref": "#/$defs/slugList" },
        "summary": { "type": "string", "minLength": 1 },
        "abstract": { "type": "string", "minLength": 1 },
        "abstract_zh": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "object",
          "required": ["code", "datasets", "models", "simulation_tools"],
          "additionalProperties": false,
          "properties": {
            "code": { "$ref": "#/$defs/artifactSlot" },
            "datasets": { "$ref": "#/$defs/artifactSlot" },
            "models": { "$ref": "#/$defs/artifactSlot" },
            "simulation_tools": { "$ref": "#/$defs/artifactSlot" }
          }
        },
        "last_verified": { "$ref": "#/$defs/date" }
      }
    },
    "catalogResourceBase": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "name",
        "description",
        "scope",
        "links",
        "license",
        "related_papers",
        "last_verified"
      ],
      "properties": {
        "kind": {
          "enum": ["dataset", "model", "simulation-tool"]
        },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/externalLink" }
        },
        "license": { "type": "string", "minLength": 1 },
        "related_papers": { "$ref": "#/$defs/slugList" },
        "featured": { "type": "boolean" },
        "last_verified": { "$ref": "#/$defs/date" }
      }
    },
    "dataset": {
      "allOf": [
        { "$ref": "#/$defs/catalogResourceBase" },
        {
          "type": "object",
          "required": ["modalities", "data_origin", "access", "tasks", "specifications"],
          "properties": {
            "kind": { "const": "dataset" },
            "modalities": { "$ref": "#/$defs/slugList" },
            "data_origin": { "enum": ["measured", "simulated", "hybrid"] },
            "access": { "enum": ["open", "registration", "restricted"] },
            "tasks": { "$ref": "#/$defs/slugList" },
            "evaluation": {
              "type": "object",
              "required": ["name", "protocol", "metrics"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "protocol": { "$ref": "#/$defs/externalLink" },
                "metrics": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            },
            "specifications": {
              "type": "object",
              "required": [
                "version",
                "scale",
                "download_size",
                "frequency_bands",
                "scenarios",
                "antenna_configurations"
              ],
              "additionalProperties": false,
              "properties": {
                "version": { "type": ["string", "null"] },
                "scale": { "type": ["string", "null"] },
                "download_size": { "type": ["string", "null"] },
                "frequency_bands": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                },
                "scenarios": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                },
                "antenna_configurations": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "model": {
      "allOf": [
        { "$ref": "#/$defs/catalogResourceBase" },
        {
          "type": "object",
          "required": ["framework", "modalities", "tasks", "access"],
          "properties": {
            "kind": { "const": "model" },
            "framework": { "type": "string", "minLength": 1 },
            "modalities": { "$ref": "#/$defs/slugList" },
            "tasks": { "$ref": "#/$defs/slugList" },
            "access": { "enum": ["open", "registration", "restricted"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "simulationTool": {
      "allOf": [
        { "$ref": "#/$defs/catalogResourceBase" },
        {
          "type": "object",
          "required": ["tool_type", "access", "capabilities"],
          "properties": {
            "kind": { "const": "simulation-tool" },
            "tool_type": {
              "enum": ["channel", "ray-tracing", "system", "commercial"]
            },
            "access": { "enum": ["open", "registration", "restricted"] },
            "capabilities": { "$ref": "#/$defs/slugList" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
